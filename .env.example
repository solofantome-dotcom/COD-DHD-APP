# GEMINI_API_KEY: Required for Gemini AI product standardization.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or Vercel Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

